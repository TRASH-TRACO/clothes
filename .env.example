# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) 기본 지역을 아직 /settings 에서 정하지 않았을 때 쓸 좌표. 없으면 서울로 본다.
# WEATHER_LAT=37.57
# WEATHER_LON=126.98
# WEATHER_CITY=서울

# AI 코디 추천을 쓰려면 필요하다. 회원이 맡긴 API 키를 잠글 때 쓰는 값이라
# 없으면 키를 아예 안 받는다. 아무 긴 문자열이면 된다 (32자 이상 권장).
#   openssl rand -base64 32
# 바꾸면 이미 맡아둔 키를 못 풀어서 다시 등록해야 한다.
# APP_SECRET=

# (선택) 서버 공용 키. 회원이 자기 키를 안 넣었을 때만 쓴다.
# 혼자 쓰거나 시험할 때만 넣으면 된다. 넣어두면 요금이 전부 이쪽으로 나온다.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# (선택) 저녁 6시 알림. 아래 넷이 다 있어야 켜진다 — 하나라도 없으면 기능이 숨는다.
#
# 1) 알림 열쇠 한 쌍. 공개 키는 브라우저에 주는 값이라 숨길 필요 없고,
#    개인 키는 서버에만 둔다. 이 쌍을 바꾸면 이미 켜 둔 구독이 전부 무효가 된다.
#      npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 2) 푸시 서비스가 문제 생겼을 때 연락할 곳
# VAPID_SUBJECT=mailto:you@example.com
# 3) 정해진 시각에 서버 혼자 돌면서 모두의 구독을 읽는다 (그때는 세션이 없다).
#    Supabase 프로젝트 설정 > API 의 service_role 키.
# SUPABASE_SERVICE_ROLE_KEY=
# 4) 알림 보내는 주소를 아무나 못 부르게 막는다. 없으면 아무도 못 부른다.
#    Vercel 이 이 값을 Authorization 헤더에 담아 부른다.
#      openssl rand -base64 32
# CRON_SECRET=
