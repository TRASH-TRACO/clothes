# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) 기본 지역을 아직 /settings 에서 정하지 않았을 때 쓸 좌표. 없으면 서울로 본다.
# WEATHER_LAT=37.57
# WEATHER_LON=126.98
# WEATHER_CITY=서울

# AI 코디 추천을 쓰려면 필요하다. 회원이 맡긴 API 키를 잠글 때 쓰는 값이라
# 없으면 키를 아예 안 받는다. 아무 긴 문자열이면 된다 (32자 이상 권장).
#   openssl rand -base64 32
# 바꾸면 이미 맡아둔 키를 못 풀어서 다시 등록해야 한다.
# APP_SECRET=

# (선택) 서버 공용 키. 회원이 자기 키를 안 넣었을 때만 쓴다.
# 혼자 쓰거나 시험할 때만 넣으면 된다. 넣어두면 요금이 전부 이쪽으로 나온다.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
